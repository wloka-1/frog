{
  "name": "frog-desktop",
  "productName": "Frog",
  "version": "0.1.0",
  "description": "Desktop window for a frog terminal server",
  "license": "MIT",
  "author": "frog contributors",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "dev.frog.desktop",
    "productName": "Frog",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "icon.png"
    ],
    "directories": {
      "output": "out"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Frog-Setup-${version}-${arch}.exe"
    },
    "dmg": {
      "artifactName": "Frog-${version}-${arch}.dmg"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png",
      "category": "Development"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
